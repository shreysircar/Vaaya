generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String      @id @default(cuid())
  total     Float
  status    String      @default("pending")
  createdAt DateTime    @default(now())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  isAdmin   Boolean    @default(false)
  createdAt DateTime   @default(now())
  orders    Order[]
  carts     Cart[]
  wishlists Wishlist[]
}

// 🧩 Categories setup

model ParentCategory {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?
  imageUrl         String?
  subcategories    SubCategory[]
  products         Product[]         @relation("ParentCategoryToProducts")
  homepageSections HomepageSection[]
  sales            Sale[]            @relation("ParentCategoryToSales")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SubCategory {
  id               String         @id @default(cuid())
  name             String
  description      String?
  parentCategoryId String
  parentCategory   ParentCategory @relation(fields: [parentCategoryId], references: [id], onDelete: Cascade)
  products         Product[]      @relation("SubCategoryToProducts")
  sales            Sale[]         @relation("SubCategoryToSales")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([name, parentCategoryId])
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  description      String
  price            Float
  stock            Int
  imageUrl         String? // existing single main image
  imageUrls        String[]               @default([]) // NEW: array of image URLs
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  parentCategoryId String
  subCategoryId    String
  parentCategory   ParentCategory         @relation("ParentCategoryToProducts", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subCategory      SubCategory            @relation("SubCategoryToProducts", fields: [subCategoryId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  specifications   ProductSpecification[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  sales            Sale[]                 @relation("ProductToSales")
}

model ProductSpecification {
  id        String  @id @default(cuid())
  key       String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model HomepageSection {
  id               String          @id @default(cuid())
  type             String // "featured_categories", "highlighted_category", "trending_products", "brand_story"
  heading          String?
  subheading       String?
  description      String?
  imageUrl         String?
  imageUrls        String[]
  linkedCategoryId String?
  linkedCategory   ParentCategory? @relation(fields: [linkedCategoryId], references: [id], onDelete: SetNull)
  linkedProductIds String[]
  categoryIds      String[]
  orderIndex       Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// 🛒 CART FEATURE
model Cart {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  price     Float?
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

// 💛 WISHLIST FEATURE
model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 💸 SALE SYSTEM
model Sale {
  id             String   @id @default(cuid())
  title          String
  description    String?
  discountType   String   @default("percentage") // "percentage" | "fixed"
  discountValue  Float
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  bannerImageUrl String?
  bannerText     String?

  parentCategoryId String?
  subCategoryId    String?
  productId        String?

  parentCategory ParentCategory? @relation("ParentCategoryToSales", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategory    SubCategory?    @relation("SubCategoryToSales", fields: [subCategoryId], references: [id], onDelete: SetNull)
  product        Product?        @relation("ProductToSales", fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
